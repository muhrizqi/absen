<div class="page-header">
    <div class="header-titles">
        <a href="/groups" class="back-btn"><span class="material-icons-round">arrow_back</span></a>
        <h2 class="page-title"><%= title %></h2>
    </div>
</div>

<div class="form-container glass-card fade-in">
    <form action="<%= group ? '/groups/' + group.id : '/groups' %>" method="POST">
        <div class="form-group">
            <label class="form-label">Kegiatan</label>
            <select name="activity_id" class="form-control" required>
                <option value="">-- Pilih Kegiatan --</option>
                <% activities.forEach(a => { %>
                    <option value="<%= a.id %>" <%= (group && group.activity_id === a.id) ? 'selected' : '' %>><%= a.name %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Nama Kelompok</label>
            <input type="text" name="name" class="form-control" value="<%= group ? group.name : '' %>" required>
        </div>
        <div class="form-group">
            <label class="form-label">Fasilitator</label>
            <select name="facilitator_id" class="form-control">
                <option value="">-- Pilih Fasilitator (Opsional) --</option>
                <% facilitators.forEach(f => { %>
                    <option value="<%= f.id %>" <%= (group && group.facilitator_id === f.id) ? 'selected' : '' %>><%= f.full_name %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-actions">
            <a href="/groups" class="btn btn-secondary">Batal</a>
            <button type="submit" class="btn btn-primary ripple">Simpan</button>
        </div>
    </form>
</div>
