<div class="page-header">
    <div class="header-titles">
        <a href="/dashboard" class="back-btn"><span class="material-icons-round">arrow_back</span></a>
        <h2 class="page-title">Pengaturan</h2>
    </div>
</div>

<div class="form-container glass-card fade-in">
    <form action="/settings" method="POST">
        
        <div class="alert alert-info glass-effect" style="margin-bottom: 1.5rem; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); color: #60A5FA;">
            <span class="material-icons-round">info</span>
            <% if (user.role === 'superadmin') { %>
                Anda sedang mengedit <strong>Template Global (Default)</strong> yang akan digunakan jika user tidak memiliki template kustom.
            <% } else { %>
                Anda sedang mengedit <strong>Template Pribadi</strong> Anda. Kosongkan jika ingin menggunakan template default dari sistem.
            <% } %>
        </div>

        <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <h4 style="margin-top: 0; color: var(--primary-color);">Variabel yang bisa digunakan:</h4>
            <ul style="color: rgba(255,255,255,0.7); font-size: 0.9rem; margin-bottom: 0; padding-left: 1.2rem;">
                <li><code>{nama_wali}</code> - Nama wali peserta</li>
                <li><code>{nama_anak}</code> - Nama lengkap peserta</li>
                <li><code>{nama_panggilan}</code> - Nama panggilan peserta</li>
                <li><code>{kegiatan}</code> - Nama kegiatan (misal: Siber)</li>
                <li><code>{kelompok}</code> - Nama kelompok</li>
                <li><code>{tanggal}</code> - Tanggal sesi</li>
                <li><code>{waktu}</code> - Jam saat absen</li>
            </ul>
        </div>

        <h3 class="section-title">Template Notifikasi Kehadiran</h3>
        <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-bottom: 10px;">Dikirim otomatis saat anak diabsen "Hadir".</p>
        <div class="form-group">
            <textarea name="tpl_attendance" class="form-control" rows="8"><%= tplAttendance %></textarea>
        </div>

        <h3 class="section-title" style="margin-top: 2rem;">Template Notifikasi Kegiatan Selesai</h3>
        <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-bottom: 10px;">Dikirim ke semua wali yang anaknya hadir saat sesi ditutup.</p>
        <div class="form-group">
            <textarea name="tpl_session_end" class="form-control" rows="8"><%= tplSessionEnd %></textarea>
        </div>

        <div class="form-actions" style="margin-top: 2rem;">
            <button type="submit" class="btn btn-primary ripple" style="width: 100%;">
                <span class="material-icons-round">save</span> Simpan Pengaturan
            </button>
        </div>
    </form>
</div>

<div class="form-container glass-card fade-in" style="margin-top: 1.5rem;">
    <h3 class="section-title" style="margin-top: 0;">Test Kirim Pesan WhatsApp</h3>
    <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-bottom: 10px;">
        Kirim pesan percobaan untuk memastikan koneksi WhatsApp (WAHA) sudah aktif dan nomor terformat dengan benar.
    </p>

    <div id="test-wa-result"></div>

    <div class="form-group" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <input
            type="text"
            id="test-wa-phone"
            class="form-control"
            placeholder="Contoh: 08123456789"
            style="flex: 1; min-width: 200px;"
        />
        <button type="button" id="test-wa-btn" class="btn btn-primary ripple">
            <span class="material-icons-round">send</span> Kirim Test
        </button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('test-wa-btn');
    const phoneInput = document.getElementById('test-wa-phone');
    const resultBox = document.getElementById('test-wa-result');

    function showResult(success, message) {
        resultBox.innerHTML = `
            <div class="alert ${success ? 'alert-success' : 'alert-error'} glass-effect" style="margin-bottom: 1rem;">
                <span class="material-icons-round">${success ? 'check_circle' : 'error'}</span>
                ${message}
            </div>
        `;
    }

    btn.addEventListener('click', async () => {
        const phone = phoneInput.value.trim();
        if (!phone) {
            showResult(false, 'Masukkan nomor WhatsApp terlebih dahulu.');
            return;
        }

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-icons-round">hourglass_top</span> Mengirim...';
        resultBox.innerHTML = '';

        try {
            const res = await fetch('/settings/test-wa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone })
            });
            const data = await res.json();

            if (data.success) {
                showResult(true, 'Pesan test berhasil dikirim! Silakan cek WhatsApp tujuan.');
            } else {
                showResult(false, 'Gagal mengirim: ' + (data.error || 'Terjadi kesalahan tidak diketahui.'));
            }
        } catch (err) {
            showResult(false, 'Gagal menghubungi server. Coba lagi.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });
});
</script>

<% if (user.role === 'superadmin') { %>
<div class="form-container glass-card fade-in" style="margin-top: 1.5rem;">
    <h3 class="section-title" style="margin-top: 0;">Backup &amp; Restore Data</h3>
    <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-bottom: 10px;">
        Backup mengunduh seluruh data aplikasi (pengguna, kegiatan, kelompok, peserta, sesi, absensi) dalam satu file JSON.
        Simpan file ini di tempat yang aman secara berkala.
    </p>

    <a href="/settings/backup" class="btn btn-primary ripple" style="width: 100%; justify-content: center; margin-bottom: 1.5rem;">
        <span class="material-icons-round">download</span> Download Backup
    </a>

    <hr style="border-color: rgba(255,255,255,0.1); margin: 1.5rem 0;">

    <div class="alert alert-error glass-effect" style="margin-bottom: 1rem;">
        <span class="material-icons-round">warning</span>
        Restore akan <strong>menghapus seluruh data saat ini</strong> dan menggantinya dengan isi file backup. Tindakan ini tidak bisa dibatalkan.
    </div>

    <div id="restore-result"></div>

    <div class="form-group">
        <label>Pilih File Backup (.json)</label>
        <input type="file" id="restoreFile" class="form-control" accept="application/json,.json">
    </div>

    <button type="button" id="restoreBtn" class="btn btn-primary ripple" style="width: 100%; justify-content: center; background: #EF4444;">
        <span class="material-icons-round">restore</span> Restore Data
    </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const restoreBtn = document.getElementById('restoreBtn');
    const fileInput = document.getElementById('restoreFile');
    const resultBox = document.getElementById('restore-result');

    function showRestoreResult(success, message) {
        resultBox.innerHTML = `
            <div class="alert ${success ? 'alert-success' : 'alert-error'} glass-effect" style="margin-bottom: 1rem;">
                <span class="material-icons-round">${success ? 'check_circle' : 'error'}</span>
                ${message}
            </div>
        `;
    }

    restoreBtn.addEventListener('click', () => {
        const file = fileInput.files[0];
        if (!file) {
            showRestoreResult(false, 'Pilih file backup (.json) terlebih dahulu.');
            return;
        }

        const confirmed = confirm(
            'PERINGATAN: Semua data saat ini akan DIHAPUS dan diganti dengan isi file backup ini.\n\n' +
            'Tindakan ini TIDAK BISA dibatalkan. Lanjutkan restore?'
        );
        if (!confirmed) return;

        const reader = new FileReader();
        reader.onload = async (e) => {
            let parsed;
            try {
                parsed = JSON.parse(e.target.result);
            } catch (err) {
                showRestoreResult(false, 'File bukan JSON yang valid.');
                return;
            }

            const originalHtml = restoreBtn.innerHTML;
            restoreBtn.disabled = true;
            restoreBtn.innerHTML = '<span class="material-icons-round">hourglass_top</span> Memproses restore...';
            resultBox.innerHTML = '';

            try {
                const res = await fetch('/settings/restore', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(parsed)
                });

                if (res.redirected) {
                    // Server flashes success/error and redirects back to /settings
                    window.location.href = res.url;
                    return;
                }

                const data = await res.json().catch(() => null);
                showRestoreResult(false, (data && data.error) || 'Gagal melakukan restore.');
            } catch (err) {
                showRestoreResult(false, 'Gagal menghubungi server. Coba lagi.');
            } finally {
                restoreBtn.disabled = false;
                restoreBtn.innerHTML = originalHtml;
            }
        };
        reader.readAsText(file);
    });
});
</script>
<% } %>
