<div class="page-header">
    <div class="header-titles">
        <a href="/dashboard" class="back-btn"><span class="material-icons-round">arrow_back</span></a>
        <h2 class="page-title">Pengaturan</h2>
    </div>
</div>

<div class="form-container glass-card fade-in">
    <form action="/settings" method="POST">
        
        <div class="alert alert-info glass-effect" style="margin-bottom: 1.5rem; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); color: #60A5FA;">
            <span class="material-icons-round">info</span>
            <% if (user.role === 'superadmin') { %>
                Anda sedang mengedit <strong>Template Global (Default)</strong> yang akan digunakan jika user tidak memiliki template kustom.
            <% } else { %>
                Anda sedang mengedit <strong>Template Pribadi</strong> Anda. Kosongkan jika ingin menggunakan template default dari sistem.
            <% } %>
        </div>

        <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <h4 style="margin-top: 0; color: var(--primary-color);">Variabel yang bisa digunakan:</h4>
            <ul style="color: rgba(255,255,255,0.7); font-size: 0.9rem; margin-bottom: 0; padding-left: 1.2rem;">
                <li><code>{nama_wali}</code> - Nama wali peserta</li>
                <li><code>{nama_anak}</code> - Nama lengkap peserta</li>
                <li><code>{nama_panggilan}</code> - Nama panggilan peserta</li>
                <li><code>{kegiatan}</code> - Nama kegiatan (misal: Siber)</li>
                <li><code>{kelompok}</code> - Nama kelompok</li>
                <li><code>{tanggal}</code> - Tanggal sesi</li>
                <li><code>{waktu}</code> - Jam saat absen</li>
            </ul>
        </div>

        <h3 class="section-title">Template Notifikasi Kehadiran</h3>
        <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-bottom: 10px;">Dikirim otomatis saat anak diabsen "Hadir".</p>
        <div class="form-group">
            <textarea name="tpl_attendance" class="form-control" rows="8"><%= tplAttendance %></textarea>
        </div>

        <h3 class="section-title" style="margin-top: 2rem;">Template Notifikasi Kegiatan Selesai</h3>
        <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin-bottom: 10px;">Dikirim ke semua wali yang anaknya hadir saat sesi ditutup.</p>
        <div class="form-group">
            <textarea name="tpl_session_end" class="form-control" rows="8"><%= tplSessionEnd %></textarea>
        </div>

        <div class="form-actions" style="margin-top: 2rem;">
            <button type="submit" class="btn btn-primary ripple" style="width: 100%;">
                <span class="material-icons-round">save</span> Simpan Pengaturan
            </button>
        </div>
    </form>
</div>
