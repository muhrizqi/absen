<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %> | Absensi RMJ</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: linear-gradient(135deg, var(--bg-color) 0%, #0d2a1a 100%);
            margin: 0;
            padding: 1rem;
        }
        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 2.5rem 2rem;
            text-align: center;
        }
        .logo {
            font-size: 3rem;
            color: var(--accent-color);
            margin-bottom: 1rem;
        }
        .login-title {
            margin-bottom: 2rem;
            color: var(--text-color);
        }
        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }
        .form-control {
            width: 100%;
            padding: 1rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--border-radius);
            color: var(--text-color);
            font-family: inherit;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
        }
        .btn-primary {
            width: 100%;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="login-container glass-card fade-in">
        <span class="material-icons-round logo">mosque</span>
        <h1 class="login-title">Absensi RMJ</h1>
        
        <% if (error && error.length > 0) { %>
            <div class="alert alert-error" style="margin-bottom: 1.5rem; border-radius: var(--border-radius); padding: 0.75rem; background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);">
                <%= error %>
            </div>
        <% } %>

        <form action="/auth/login" method="POST">
            <div class="form-group">
                <input type="text" name="username" class="form-control" placeholder="Username" required autofocus>
            </div>
            <div class="form-group">
                <input type="password" name="password" class="form-control" placeholder="Password" required>
            </div>
            <button type="submit" class="btn btn-primary ripple">Login</button>
        </form>
    </div>
</body>
</html>
