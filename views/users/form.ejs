<div class="page-header">
    <div class="header-titles">
        <a href="/users" class="back-btn"><span class="material-icons-round">arrow_back</span></a>
        <h2 class="page-title"><%= title %></h2>
    </div>
</div>

<div class="form-container glass-card fade-in">
    <form action="<%= u ? '/users/' + u.id : '/users' %>" method="POST">
        <div class="form-group">
            <label class="form-label">Nama Lengkap</label>
            <input type="text" name="full_name" class="form-control" value="<%= u ? u.full_name : '' %>" required>
        </div>
        <div class="form-group">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" value="<%= u ? u.username : '' %>" required>
        </div>
        <div class="form-group">
            <label class="form-label">Password <%= u ? '(Kosongkan jika tidak diubah)' : '' %></label>
            <input type="password" name="password" class="form-control" <%= u ? '' : 'required' %>>
        </div>
        <div class="form-group">
            <label class="form-label">No. Telepon / WhatsApp</label>
            <input type="text" name="phone" class="form-control" value="<%= u ? u.phone : '' %>">
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <select name="role" class="form-control" id="role-select" required onchange="toggleCoordinatorActivities()">
                <option value="facilitator" <%= (u && u.role === 'facilitator') ? 'selected' : '' %>>Fasilitator</option>
                <option value="coordinator" <%= (u && u.role === 'coordinator') ? 'selected' : '' %>>Koordinator</option>
                <option value="superadmin" <%= (u && u.role === 'superadmin') ? 'selected' : '' %>>Superadmin</option>
            </select>
        </div>
        
        <div class="form-group" id="coordinator-activities" style="display: none;">
            <label class="form-label">Kegiatan yang Diawasi (Untuk Koordinator)</label>
            <div class="checkbox-group">
                <% activities.forEach(act => { %>
                    <label class="checkbox-label">
                        <input type="checkbox" name="activity_ids" value="<%= act.id %>" 
                            <%= (u && u.coordinator_activity_ids && u.coordinator_activity_ids.includes(act.id)) ? 'checked' : '' %>>
                        <%= act.name %>
                    </label>
                <% }) %>
            </div>
        </div>

        <div class="form-actions">
            <a href="/users" class="btn btn-secondary">Batal</a>
            <button type="submit" class="btn btn-primary ripple">Simpan</button>
        </div>
    </form>
</div>

<script>
function toggleCoordinatorActivities() {
    const roleSelect = document.getElementById('role-select');
    const activitiesDiv = document.getElementById('coordinator-activities');
    if (roleSelect.value === 'coordinator') {
        activitiesDiv.style.display = 'block';
    } else {
        activitiesDiv.style.display = 'none';
    }
}
// Run on load
document.addEventListener('DOMContentLoaded', toggleCoordinatorActivities);
</script>
