<div class="page-header" style="flex-direction: column; align-items: flex-start; gap: 10px;">
    <div class="header-titles" style="width: 100%;">
        <a href="/reports" class="back-btn"><span class="material-icons-round">arrow_back</span></a>
        <div>
            <h2 class="page-title"><%= facilitator.full_name %></h2>
            <span style="color: rgba(255,255,255,0.6); font-size: 0.9rem;">
                <% if(filters.start_date && filters.end_date) { %>
                    <%= new Date(filters.start_date).toLocaleDateString('id-ID') %> - <%= new Date(filters.end_date).toLocaleDateString('id-ID') %>
                <% } else { %>
                    Semua Waktu
                <% } %>
            </span>
        </div>
    </div>
</div>

<!-- Summary cards -->
<div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
    <div class="glass-card fade-in" style="flex: 1; min-width: 120px; padding: 1rem; text-align: center;">
        <div style="font-size: 1.6rem; font-weight: bold; color: var(--text-color);"><%= summary.totalSessions %></div>
        <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">Sesi Dijalankan</div>
    </div>
    <div class="glass-card fade-in" style="flex: 1; min-width: 120px; padding: 1rem; text-align: center;">
        <div style="font-size: 1.6rem; font-weight: bold; color: var(--primary-color);"><%= summary.totalPresent %></div>
        <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">Total Hadir</div>
    </div>
    <div class="glass-card fade-in" style="flex: 1; min-width: 120px; padding: 1rem; text-align: center;">
        <% let pctColor = summary.overallPercentage >= 75 ? '#10B981' : (summary.overallPercentage >= 50 ? '#F59E0B' : '#EF4444'); %>
        <div style="font-size: 1.6rem; font-weight: bold; color: <%= pctColor %>;"><%= summary.overallPercentage %>%</div>
        <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">Kehadiran</div>
    </div>
</div>

<div class="glass-card fade-in" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <h3 class="section-title" style="margin-top: 0;">Perkembangan per Bulan</h3>
    <% if (trend && trend.length > 0) { %>
        <div style="position: relative; height: 260px;">
            <canvas id="facilitatorTrendChart"></canvas>
        </div>
    <% } else { %>
        <p style="color: rgba(255,255,255,0.5); text-align: center; padding: 1rem 0;">Belum cukup data untuk menampilkan grafik perkembangan.</p>
    <% } %>
</div>

<div class="glass-card fade-in" style="overflow-x: auto; padding: 0;">
    <table class="report-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="background: rgba(0,0,0,0.2);">
                <th style="padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--primary-color);">Kegiatan</th>
                <th style="padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--primary-color);">Kelompok</th>
                <th style="padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--primary-color); text-align: center;">Total Sesi</th>
                <th style="padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--primary-color); text-align: center;">Hadir</th>
                <th style="padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--primary-color); text-align: center;">%</th>
            </tr>
        </thead>
        <tbody>
            <% if (reportData && reportData.length > 0) { %>
                <% reportData.forEach(row => { 
                    const rows = Number(row.total_attendance_rows || 0);
                    const present = Number(row.present_count || 0);
                    const pct = rows > 0 ? Math.round((present / rows) * 10000) / 100 : 0;
                    const color = pct >= 75 ? '#10B981' : (pct >= 50 ? '#F59E0B' : '#EF4444');
                %>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <td style="padding: 1rem;"><%= row.activity_name %></td>
                        <td style="padding: 1rem;"><strong><%= row.group_name %></strong></td>
                        <td style="padding: 1rem; text-align: center;"><%= row.total_sessions || 0 %></td>
                        <td style="padding: 1rem; text-align: center;"><%= present %></td>
                        <td style="padding: 1rem; text-align: center;">
                            <span style="color: <%= color %>; font-weight: bold;"><%= pct %>%</span>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="padding: 2rem; text-align: center; color: rgba(255,255,255,0.5);">
                        Fasilitator ini belum mengampu kelompok manapun.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<% if (trend && trend.length > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const trendData = <%- JSON.stringify(trend) %>;

    const labels = trendData.map(t => {
        const [y, m] = t.month.split('-');
        return new Date(Number(y), Number(m) - 1, 1).toLocaleDateString('id-ID', { month: 'short', year: '2-digit' });
    });
    const sessionsData = trendData.map(t => t.sessions);
    const percentages = trendData.map(t => t.percentage);

    const ctx = document.getElementById('facilitatorTrendChart').getContext('2d');
    new Chart(ctx, {
        data: {
            labels: labels,
            datasets: [
                {
                    type: 'bar',
                    label: 'Jumlah Sesi',
                    data: sessionsData,
                    backgroundColor: 'rgba(96, 165, 250, 0.4)',
                    borderColor: '#60A5FA',
                    borderWidth: 1,
                    yAxisID: 'ySessions',
                    order: 2
                },
                {
                    type: 'line',
                    label: 'Kehadiran (%)',
                    data: percentages,
                    borderColor: '#10B981',
                    backgroundColor: 'rgba(16, 185, 129, 0.15)',
                    tension: 0.3,
                    pointBackgroundColor: '#10B981',
                    pointRadius: 4,
                    yAxisID: 'yPercentage',
                    order: 1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { labels: { color: 'rgba(255,255,255,0.8)' } },
                tooltip: {
                    callbacks: {
                        label: (ctx) => ctx.dataset.yAxisID === 'yPercentage'
                            ? `Kehadiran: ${ctx.parsed.y}%`
                            : `Jumlah Sesi: ${ctx.parsed.y}`
                    }
                }
            },
            scales: {
                ySessions: {
                    position: 'left',
                    beginAtZero: true,
                    ticks: { color: 'rgba(255,255,255,0.6)', stepSize: 1 },
                    grid: { color: 'rgba(255,255,255,0.08)' },
                    title: { display: true, text: 'Sesi', color: 'rgba(255,255,255,0.5)' }
                },
                yPercentage: {
                    position: 'right',
                    min: 0,
                    max: 100,
                    ticks: { color: 'rgba(255,255,255,0.6)', callback: (v) => v + '%' },
                    grid: { display: false },
                    title: { display: true, text: 'Kehadiran', color: 'rgba(255,255,255,0.5)' }
                },
                x: {
                    ticks: { color: 'rgba(255,255,255,0.6)' },
                    grid: { display: false }
                }
            }
        }
    });
});
</script>
<% } %>
